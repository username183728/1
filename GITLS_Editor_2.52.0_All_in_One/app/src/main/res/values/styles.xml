<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.App" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/mt_text</item>
        <item name="colorAccent">@color/mt_text</item>
        <item name="android:statusBarColor">@color/mt_bg</item>
        <item name="android:navigationBarColor">@color/mt_bg</item>
        <item name="android:windowBackground">@color/mt_bg</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:dialogTheme">@style/AppDialogTheme</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:spinnerStyle">@style/AppSpinner</item>
    </style>
    <style name="AppTheme" parent="Base.Theme.App" />
    <style name="AppDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:colorAccent">@color/mt_text</item>
        <item name="colorAccent">@color/mt_text</item>
    </style>
    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
    </style>
    <style name="AppSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mt_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/app_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
